# ── Site ────────────────────────────────────────────────────────────────
# Canonical production origin (no trailing slash). Used for canonical URLs,
# Open Graph, sitemap and robots. Do NOT point at a Vercel preview domain.
NEXT_PUBLIC_SITE_URL=https://contraste-atelier.com

# ── Workshop / Supabase ─────────────────────────────────────────────────
# Booking, availability, realtime and admin stay dormant until these exist.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Workshop price in MXN (digits only, e.g. 3500). If empty, the site shows
# the workshop without a price — it never invents or reuses a stale price.
NEXT_PUBLIC_WORKSHOP_PRICE_MXN=

# ── Admin ───────────────────────────────────────────────────────────────
# Comma-separated emails allowed into /admin/workshops (magic-link auth).
ADMIN_EMAIL_ALLOWLIST=

# ── Notifications ───────────────────────────────────────────────────────
# Resend-compatible API key. Emails are skipped (and marked skipped) if empty;
# a notification failure never rolls back a confirmed booking.
TRANSACTIONAL_EMAIL_API_KEY=
BOOKING_FROM_EMAIL=
BOOKING_INTERNAL_EMAIL=
# Structured workshop.booking.* events (n8n / WhatsApp / CRM later).
BOOKING_WEBHOOK_URL=
BOOKING_WEBHOOK_SECRET=

# ── Shopify (dedicated CONTRASTE store only) ────────────────────────────
# Keep SHOPIFY_ENABLED=false until the dedicated store is configured.
SHOPIFY_ENABLED=false
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_PUBLIC_TOKEN=
# Server only. Never exposed to the browser.
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
SHOPIFY_STOREFRONT_API_VERSION=2025-07

# ── Analytics (optional; events no-op without IDs; no PII ever sent) ────
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
